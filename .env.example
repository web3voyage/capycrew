# Optional deployment configuration. Do not commit real secrets.
APP_ENV=development
# Absolute origin used for canonical links, Open Graph images, robots.txt, and the
# sitemap. Leave blank locally: the app falls back to Render's RENDER_EXTERNAL_URL and
# then to the request origin.
PUBLIC_SITE_URL=
# Serve the interactive API docs at /docs, /redoc, and /openapi.json. Off in production.
ENABLE_API_DOCS=false
# Site-level mint switch. Set to false to hold the portal back: /mint serves the
# coming-soon page, its links are relabelled, and the mint APIs return 503.
# Remove it or set true to open the mint. Unrelated to the contract's own
# publicMintEnabled flag, which decides whether a transaction would succeed.
MINT_ENABLED=true
MINT_CONTRACT_ADDRESS=
MINT_CHAIN_ID=46630
MINT_CHAIN_NAME=Robinhood Chain Testnet
MINT_NATIVE_CURRENCY_NAME=Ether
MINT_NATIVE_CURRENCY_SYMBOL=ETH
MINT_PRICE_USD=5
RPC_URL=https://rpc.testnet.chain.robinhood.com
EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
